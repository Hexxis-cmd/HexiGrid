# Keep the local API on loopback unless a secure remote gateway is configured.
HEXIGRID_PORT=4318
HEXIGRID_HOST=127.0.0.1
HEXIGRID_DATA_DIR=

# Required before network mode can bind beyond this computer. Use one PFX file
# or a PEM certificate + private key. The certificate must be trusted by every
# phone/tablet and cover the hostname or IP address used in the browser.
HEXIGRID_TLS_PFX=
HEXIGRID_TLS_CERT=
HEXIGRID_TLS_KEY=
HEXIGRID_TLS_PASSPHRASE=

# Optional diagnostic overrides for unusual CLI installations. Normal users
# connect detected signed-in tools from the same Connections screen as APIs.
OPENCODE_CLI=
CLAUDE_CLI=
CODEX_CLI=
